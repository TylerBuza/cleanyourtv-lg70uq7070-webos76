#!/bin/sh
# Boot hook: stop LG telemetry/ad daemons ~60 s after boot. Disable: touch /media/developer/cleanyourtv/DISABLE-DEBLOAT
L=${CYTV_DIR:-$(dirname "$(readlink -f "$0")")}
export CYTV_DIR="$L"
[ -f "$L/runtime-env.sh" ] && . "$L/runtime-env.sh"
[ "${CYTV_EXTERNAL_DEBLOAT:-0}" = 1 ] && exit 0
[ -e "$L/DISABLE-DEBLOAT" ] && exit 0
[ -e "$L/DISABLE" ] && exit 0   # LG's own Home breaks without the services this blocks
(sleep 60; { grep -q ' /usr/palm/applications/com.webos.app.home ' /proc/mounts || [ -f /tmp/cleanyourtv-home-standin ]; } && sh "$L/debloat-stop.sh") </dev/null >/dev/null 2>&1 &
